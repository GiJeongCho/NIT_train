# NIT_train 배포 설정 — 복사해서 .env 로 쓴다 (.env 는 커밋 금지).
#   cp .env.example .env

# 이미지 태그. 릴리스 스크립트가 버전으로 채운다. 수동이면 latest 로 둬도 된다.
NIT_TRAIN_TAG=latest

# 빌드 메타(이미지에 박혀 /api/version 으로 노출). 보통 scripts/release.* 가 자동 주입하므로
# 수동 빌드할 때만 채운다.
VERSION=1.0.0
GIT_SHA=
BUILD_DATE=

# 프런트가 심을 기본 API 주소. 비우면 브라우저가 "현재 호스트:8888" 을 쓴다(같은 호스트 배포).
# 백엔드가 다른 호스트면: NIT_TRAIN_API=http://10.0.0.5:8888
NIT_TRAIN_API=

# 추론/학습 디바이스. GPU 인덱스("0") 또는 "cpu".
NIT_TRAIN_DEVICE=0
